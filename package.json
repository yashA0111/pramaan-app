{
  "name": "pramaan-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api start:dev",
    "dev:biometric": "services/biometric/.venv/Scripts/python.exe services/biometric/app.py",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build",
    "build:web": "bun run --cwd apps/web build",
    "build:api": "bun run --cwd apps/api build",
    "start": "node .output/server/index.mjs",
    "start:web": "node .output/server/index.mjs",
    "start:api": "bun run --cwd apps/api start:prod",
    "test": "bun run test:web && bun run test:api",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/api typecheck",
    "lint": "bun run --cwd apps/web lint",
    "check": "bun run typecheck && bun run lint",
    "test:web": "bun run --cwd apps/web test",
    "test:api": "bun run --cwd apps/api test",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:seed": "bun run --cwd apps/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.7.3"
  }
}
