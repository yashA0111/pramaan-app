# ==============================================================================
# Pramaan Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
API_PORT=3001

# Database Connectivity (Supabase PostgreSQL)
# DATABASE_URL: Main pooled/direct connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DIRECT_DATABASE_URL: Used for running Drizzle migrations directly (session mode port 5432)
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# DATABASE_POOLER_URL: Transaction pooler connection string (port 6543)
DATABASE_POOLER_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Session & Security
SESSION_SECRET=pramaan-super-secure-session-secret-change-in-production-min32chars
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Demo Admin Allowlist (comma-separated email addresses authorized for demo admin)
DEMO_ADMIN_EMAILS=admin@pramaan.dev,demo-admin@pramaan.dev

# Storage Configuration
# STORAGE_DRIVER: "local" or "supabase"
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=pramaan-demo-assets

# Biometric Service Boundary (Python FastAPI Microservice)
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
BIOMETRIC_SERVICE_TOKEN=

# External Integrations (Mock / Future Production Adapters)
GOVERNMENT_API_BASE_URL=
GOVERNMENT_API_KEY=

POLICE_API_BASE_URL=
POLICE_API_KEY=

NOTIFICATION_PROVIDER=mock
NOTIFICATION_API_KEY=

# Optional Cache / Rate Limiting (Phase D+)
REDIS_URL=

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:3001/api/v1
VITE_USE_MOCK=false
